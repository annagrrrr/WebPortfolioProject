<section class="default-section">
    <div class="dashboard-projects-wrapper">
        <h2 class="dashboard-header">Projects</h2>
        <ul class="dashboard-projects">
            <% data.forEach(project => { %>
                <li>
                    <div class="dashboard-project">
                        <a href="/project/<%= project._id %>">

                            <%= project.name %> &nearr;
                        </a>
                        <div class="dashboard-project-controls">
                            <a href="/edit-project/<%= project._id %>" class="dashboard-btn btn">Edit</a>

                            <button class="dashboard-btn btn delete-btn" data-id="<%= project._id %>">Delete</button>
                        </div>
                    </div>
                </li>
            <% }) %>
        </ul>
    </div>
    <!-- <a href="/add-project" class="dashboard-btn dashboard-btn-add btn">+ Add New</a> -->

    <h2 class="add-project-header">Add project</h2>

    <form action="/add-project" method="POST" class="add-project">

        <div class="add-project-input-box">
            <input type="text" placeholder="Name" name="name">
        </div>

        <div class="add-project-input-box">
            <textarea cols="50" rows="10" placeholder="Description" name="description"></textarea>
        </div>
            
        <div class="add-project-input-box">
            <input type="text" placeholder="Cover (/img/<your_image>.png)" name="cover">
        </div>

        <!-- <input type="text" placeholder="Images" name="images"> -->

        <input type="submit" value="Add" class="add-project-button btn">
        </form>
</section>