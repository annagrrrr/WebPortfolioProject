<section class="default-section">
    <h2 class="requests-header">Requests</h2>
    <ul class="requests-list">
        <% data.forEach(request => { %>
            <li>
                <div class="requests-request">
                    <span>Name: <%= request.name %></span>
                    <span>Email: <%= request.email %></span>
                    <span><%= request.name %></span>
                    <span><%= new Date(request.createdAt).toLocaleString('ru-RU', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></span>
                </div>
                <button class="requests-btn btn" data-id="<%= request._id %>">Delete</button>
            </li>
        <% }) %>
    </ul>
</section>
