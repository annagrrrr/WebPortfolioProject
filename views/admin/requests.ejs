<section class="default-section">
    <h2 class="requests-header">Requests</h2>
    <ul class="requests-list">
        <% data.forEach(request => { %>
            <li>
                <div class="requests-request">
                    <span>
                        Name: <%= request.name %>
                    </span>
                    <span>
                        Email: <%= request.email %>
                    </span>
                    <span>
                        <%= request.name %>
                    </span>
                </div>
            </li>
            <form action="/delete-request/<%= request._id %>?_method=DELETE" method="POST">
                <input type="submit" value="Delete" class="requests-btn btn">
            </form>
        <% }) %>
    </ul>
</section>