<section class="default-section contact">
  <a href="/" class="contact-back-btn btn btn-underline">&larr; Back</a>
  <h1 class="contact-header">Contact me!</h1>
  <div class="contact-form">
    <form action="/contact" method="POST" class="contact-form-form">
      <div class="contact-input-box">
        <input type="text" required placeholder="YOUR NAME" name="name">
      </div>
      <div class="contact-input-box">
        <input type="email" required placeholder="YOUR EMAIL" name="email">
      </div>
      <div class="contact-input-box">
        <textarea required placeholder="YOUR REQUEST" name="request"></textarea>
      </div>
      <button type="submit" class="contact-btn btn btn-border">Send</button>
    </form>
  </div>
</section>
