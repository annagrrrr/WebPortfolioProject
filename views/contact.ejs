<h1 class="contact-header">Contact me!</h1>
<div class="contact-form">
    <form action="#">
        <div class="contact-input-box">
            <input type="text" required>
            <label>Name</label>
        </div>
        <div class="contact-input-box">
            <input type="email" required>
            <label>Email</label>
        </div>
        <div class="contact-input-box">
            <input type="text" required>
            <label>Query</label>
        </div>
        <button type="submit" class="contact-btn">Send</button>
    </form>
</div>