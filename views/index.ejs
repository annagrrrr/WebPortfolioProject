<section class="projects">
    <h2 class="projects__heading">My work</h2>
    <ul class="projects__list">
      <% data.forEach(project => { %>
        <li>
          <a href="#">
            <span><%= project.name %></span>
            <% if (Array.isArray(project.images)) { %>
              <% project.images.forEach(imgPath => { %>
                <img src="<%= imgPath %>" alt="<%= project.name %>">
              <% }) %>
            <% } else { %>
              <img src="<%= project.images %>" alt="<%= project.name %>">
            <% } %>
          </a>
        </li>
      <% }) %>
    </ul>

    <div class="slider-container">

      <div class="slider-wrapper swiper-wrapper">
        <div class="slider-item swiper-slide">
          <div class="slide-content">
            <h3 class="slide-subtitle">Slide 01</h3>
            <h2 class="slide-title">Main title</h2>
            <p class="slide-description">First project</p>
            <a href="#" class="slide-button"><span>Learn More</span></a>
          </div>
        </div>
        <div class="slider-item swiper-slide">
          <div class="slide-content">
            <h3 class="slide-subtitle">Slide 02</h3>
            <h2 class="slide-title">Another one</h2>
            <p class="slide-description">Second project</p>
            <a href="#" class="slide-button"><span>Learn More</span></a>
          </div>
        </div>
        <div class="slider-item swiper-slide">
          <div class="slide-content">
            <h3 class="slide-subtitle">Slide 03</h3>
            <h2 class="slide-title">Newest</h2>
            <p class="slide-description">This one is the newest</p>
            <a href="#" class="slide-button"><span>Learn More</span></a>
          </div>
        </div>
        <div class="slider-item swiper-slide">
          <div class="slide-content">
            <h3 class="slide-subtitle">Slide 04</h3>
            <h2 class="slide-title">Oldest project</h2>
            <p class="slide-description">This one is the oldest</p>
            <a href="#" class="slide-button"><span>Learn More</span></a>
          </div>
        </div>
        <div class="slider-item swiper-slide">
          <div class="slide-content">
            <h3 class="slide-subtitle">Slide 05</h3>
            <h2 class="slide-title">Something new</h2>
            <p class="slide-description">I tried something new here</p>
            <a href="#" class="slide-button"><span>Learn More</span></a>
          </div>
        </div>
      </div>

      <div class="slider-controls">
        <ul class="slider-pagination">
          <div class="slider-indicator">

          </div>
          <li class="slider-tab">lorem ipsum</li>
          <li class="slider-tab">ipsum ipsum</li>
          <li class="slider-tab">lorem lorem</li>
          <li class="slider-tab">what ipsum</li>
          <li class="slider-tab">lorem what</li>
        </ul>
      </div>

      <div class="slider-navigations">
        <button  id="slide-prev" class="material-symbols-rounded">arrow_left_alt</button>
        <button id="slide-next" class="material-symbols-rounded">arrow_right_alt</button>
      </div>
    </div>
</section>




<div class="introduction">
    <div class="author">
        <h1 class="author__heading">Portfolio</h1>
        <p class="author__body">3D artist, designer</p>
    </div>
</div>
<section class="about">
    <div class="about__card">
      <h2 class="about__heading">About me</h2>
      <p class="about__text">
        LOREM IPSUM DOLOR SIT AMET, CONSECTETUR ADIPISICING ELIT, SED DO EIUSMOD TEMPOR INCIDIDUNT UT LABORE ET DOLORE MAGNA ALIQUA.
        UT ENIM AD MINIM VENIAM, QUIS NOSTRUD EXERCITATION ULLAMCO LABORIS NISI UT ALIQUIP EX EA COMMODO CONSEQUAT.
      </p>
    </div>
</section>
<section class="apps">
  <div class="apps-card">
    <h2 class="apps-heading">What I work with</h2>
    <div class="apps-grid">
      <div class="app-item">
        <img src="/img/icons/blender.png" alt="Blender" />
        <span>Blender</span>
      </div>
      <div class="app-item">
        <img src="/img/icons/substance.png" alt="Substance Painter" />
        <span>Substance Painter</span>
      </div>
      <div class="app-item">
        <img src="/img/icons/unreal.png" alt="Unreal Engine" />
        <span>Unreal Engine</span>
      </div>
      <div class="app-item">
        <img src="/img/icons/unity.png" alt="Unity" />
        <span>Unity</span>
      </div>
      <div class="app-item">
        <img src="/img/icons/photoshop.png" alt="Photoshop" />
        <span>Photoshop</span>
      </div>
      <div class="app-item">
        <img src="/img/icons/clipstudio.png" alt="Clip Studio Paint" />
        <span>Clip Studio Paint</span>
      </div>
    </div>
  </div>
</section>
